# Environment Configuration for CipherLLD Studio

# Server Port
PORT=4000
NODE_ENV=development

# Optional: Hosted PostgreSQL Database (e.g. Supabase, Neon, Render)
# If left unset, platform automatically runs with durable in-memory storage.
DATABASE_URL=postgresql://user:password@localhost:5432/cipher_lld_db

# Optional: Google Gemini API Key for dynamic LLM evaluation
# If left unset, platform automatically uses the high-fidelity Heuristic Rule Engine.
GEMINI_API_KEY=your_gemini_api_key_here
