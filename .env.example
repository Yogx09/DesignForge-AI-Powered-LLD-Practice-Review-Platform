# =============================================================================
# DesignForge / LLD Practice Studio - Environment Configuration
# =============================================================================

# Server Port (Default: 4000)
PORT=4000

# Optional: Google Gemini API Key for Live AI Code & Architecture Evaluation
# If omitted, the platform automatically runs on the offline Heuristic & AST Rule Engine (0ms latency, zero API dependency).
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database Connection String
# If omitted, the platform automatically runs with durable In-Memory storage (zero DB setup required).
# Example: postgres://username:password@ep-host.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
